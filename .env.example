# ============================================================
# OrderFlow Observability - Variables de entorno
# ============================================================
# Copiar este archivo como .env y ajustar valores si es necesario:
#   cp .env.example .env
# ============================================================

# --- Postgres (data warehouse) ---
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_dev_2026
POSTGRES_DB=orderflow_dw
POSTGRES_PORT=5432

# --- Redis (cola de eventos) ---
REDIS_PORT=6379

# --- Order Generator (genera ordenes sinteticas) ---
# Intervalo en segundos entre ordenes generadas
GENERATION_INTERVAL_SEC=1
# Puerto del endpoint /metrics de Prometheus
GENERATOR_METRICS_PORT=8000

# --- Order Processor (consume, valida, persiste) ---
# Tasa de error simulada (%). 5 = 5% de las ordenes fallan.
# Util para probar deteccion de incidentes en Sesion 5.
ERROR_RATE_PCT=5
# Latencia base (ms) del procesamiento; se randomiza +/- 400ms
BASE_LATENCY_MS=200
# Puerto del endpoint /metrics de Prometheus
PROCESSOR_METRICS_PORT=8001

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Alertmanager ---
ALERTMANAGER_PORT=9093

# --- Elasticsearch ---
ELASTICSEARCH_PORT=9200
# Heap size - ajustar a 512m si laptop tiene 8GB, 1g si tiene 16GB+
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Logstash ---
# Puerto TCP: recibe el JSON estructurado del order-processor
LOGSTASH_TCP_PORT=5044
# Puerto syslog (UDP): recibe el texto plano del order-generator,
# enrutado por el driver de logging de Docker. Anadido en la Sesion 3.
LOGSTASH_SYSLOG_PORT=5000
LS_JAVA_OPTS=-Xms256m -Xmx256m

# --- Kibana ---
KIBANA_PORT=5601

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
